{
  "name": "speech-care-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.5.1",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/",
    "db:up": "docker compose --env-file .env.docker up -d --wait postgres",
    "db:stop": "docker compose --env-file .env.docker stop postgres",
    "db:status": "docker compose --env-file .env.docker ps",
    "migration:show": "pnpm run build && node --env-file=.env.migrations ./node_modules/typeorm/cli.js migration:show -d ./dist/database/data-source.js",
    "migration:generate": "pnpm run build && node --env-file=.env.migrations ./node_modules/typeorm/cli.js migration:generate -d ./dist/database/data-source.js",
    "migration:run": "pnpm run build && node --env-file=.env.migrations ./node_modules/typeorm/cli.js migration:run -d ./dist/database/data-source.js",
    "migration:revert": "pnpm run build && node --env-file=.env.migrations ./node_modules/typeorm/cli.js migration:revert -d ./dist/database/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/mapped-types": "12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.2",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "1.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.2"
  }
}
